# BE-02 (TASK.md) — variáveis usadas pelas migrations (node-pg-migrate).
# Copie para .env (nunca commitado, ver .gitignore) e ajuste para o ambiente
# local/CI. Em produção, o valor real vem do secret manager (SDD.md §7.5),
# nunca deste arquivo.

# String de conexão do PostgreSQL gerenciado (ADR-006). Região Brasil
# (ADR-010) é responsabilidade do provisionamento real (DevOps), não deste
# arquivo de exemplo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portalmed

# BE-03 (TASK.md) — senha da role de runtime (portalmed_app, migration
# `create-app-database-role`), lida pela migration na hora de criar a role
# (nunca hardcoded no arquivo de migration). Default acima é só para
# desenvolvimento/CI local — provisório, como todo default de TASK.md §1.1;
# em produção o valor real vem do secret manager (SDD.md §7.5).
APP_DB_ROLE_PASSWORD=portalmed_app_dev_only_change_me

# String de conexão que a aplicação (DatabaseModule) usa em runtime — role
# portalmed_app, NUNCA a role de DATABASE_URL acima (que tem privilégio de
# DDL/migration). É esta conexão que a política RLS (migration
# `enable-row-level-security`) de fato restringe — ver
# backend/docs/tenant-guard-and-rls.md.
APP_DATABASE_URL=postgresql://portalmed_app:portalmed_app_dev_only_change_me@localhost:5432/portalmed
