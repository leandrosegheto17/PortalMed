          <sequenceNumber>0</sequenceNumber>
          <enabled>true</enabled>
          <script><![CDATA[// BE-06 (TASK.md) - normalizacao estrutural feita pelo motor de mercado
// (recurso nativo de transformer step, nao um parser HL7 proprio do core -
// ADR-002/GUARDRAILS.md item 11). Extrai os campos HL7 v2.x ORU^R01
// relevantes usando a arvore de mensagem ja interpretada pelo proprio
// motor (msg, populado porque inboundDataType=HL7V2) e monta um envelope
// JSON de primeiro nivel. O mapeamento para o JSON canonico de dominio do
// projeto acontece na Anti-Corruption Layer do core (NestJS,
// backend/src/integration-engine/), nunca aqui.
var canonical = {
	messageType: msg['MSH']['MSH.9']['MSH.9.1'].toString() + '^' + msg['MSH']['MSH.9']['MSH.9.2'].toString(),
	messageControlId: msg['MSH']['MSH.10']['MSH.10.1'].toString(),
	sourceSystem: msg['MSH']['MSH.3']['MSH.3.1'].toString(),
	patientIdentifier: msg['PID']['PID.3']['PID.3.1'].toString(),
	patientName: msg['PID']['PID.5']['PID.5.1'].toString() + ' ' + msg['PID']['PID.5']['PID.5.2'].toString(),
	examCode: msg['OBR']['OBR.4']['OBR.4.1'].toString(),
	examName: msg['OBR']['OBR.4']['OBR.4.2'].toString(),
	resultValue: msg['OBX']['OBX.5']['OBX.5.1'].toString(),
	resultUnit: msg['OBX']['OBX.6']['OBX.6.1'].toString(),
	receivedAt: new Date().toISOString()
};
channelMap.put('engineNormalizedJson', JSON.stringify(canonical));]]></script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
